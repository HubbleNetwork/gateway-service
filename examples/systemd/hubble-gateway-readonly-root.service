[Unit]
Description=Hubble Network BLE Gateway
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_CACHE_HOME=/data/hubble-gateway/cache
Environment=XDG_DATA_HOME=/data/hubble-gateway/share
Environment=TMPDIR=/data/hubble-gateway/tmp
Environment=HUBBLE_AUTH_TOKEN_PATH=/data/hubble-gateway/auth.json
EnvironmentFile=/data/hubble-gateway/.env
ExecStart=/data/hubble-gateway/hubble-gateway
Restart=always
RestartSec=10
WatchdogSec=300
NotifyAccess=all

[Install]
WantedBy=multi-user.target
